<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-windows10.0.19041.0</TargetFrameworks>
    <RootNamespace>OrbitNavigator.Presentation</RootNamespace>
    <AssemblyName>OrbitNavigator.Presentation</AssemblyName>
    <Description>Framework-neutral UI state and interaction models for Orbit Navigator.</Description>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <UseWPF>true</UseWPF>
    <DefineConstants>$(DefineConstants);ORBIT_WPF</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrbitNavigator.Contracts\OrbitNavigator.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OrbitNavigator.Presentation.Wpf.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
